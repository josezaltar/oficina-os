# Copie este arquivo para ".env" e preencha os valores.
# O .env NUNCA vai para o GitHub (está no .gitignore). Este exemplo vai,
# porque não tem nenhum segredo de verdade.

# String de conexão do PostgreSQL (Neon: painel do projeto > Connect).
# Exemplo: postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Senha que criptografa o cookie de login. Precisa ter 32 caracteres ou mais.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_PASSWORD=

# "true" mostra o botão "Entrar como demonstração" na tela de login.
# Use só no deploy de demonstração (com dados inventados), nunca no da oficina.
DEMO_MODE=false
